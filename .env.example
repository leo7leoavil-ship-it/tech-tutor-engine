# --- Application ---
APP_NAME=Tech Tutor Engine
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# Bearer token required by REST (`Authorization: Bearer`) and WS (`?token=`)
API_KEY=replace-with-a-long-random-token

# --- Pre-built Vector Store (DO NOT rebuild) ---
CHROMA_PERSIST_DIR=./data/technical_corpus_db
CHROMA_COLLECTION_NAME=tech_tutor_corpus
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RAG_TOP_K=3

# --- Whisper / faster-whisper ---
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=en

# --- Llama 3 (OpenAI-compatible: Groq default) ---
LLM_PROVIDER=groq
LLM_API_KEY=replace-with-groq-or-hf-token
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Hugging Face Inference Router example:
# LLM_PROVIDER=huggingface
# LLM_MODEL=meta-llama/Meta-Llama-3-70B-Instruct
# LLM_BASE_URL=https://router.huggingface.co/v1

WS_MAX_AUDIO_BYTES=15728640
SKIP_HEAVY_INIT=false
